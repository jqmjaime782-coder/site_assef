---
export const prerender = false
import Layout from '../layouts/Layout.astro'
import CapaPagina from '../components/CapaPagina.astro'

const PAYLOAD_URL = import.meta.env.PAYLOAD_URL || 'http://localhost:3000'

let equipa: any[] = []
let faq: any = null

try {
  const [resEquipa, resFaq] = await Promise.all([
    fetch(`${PAYLOAD_URL}/api/equipa?limit=100&depth=1&sort=ordem`),
    fetch(`${PAYLOAD_URL}/api/globals/faq`),
  ])
  const dadosEquipa = await resEquipa.json()
  equipa = dadosEquipa.docs || []
  faq = await resFaq.json()
} catch (erro) {
  console.error('Erro ao ligar ao Payload:', erro)
}

const perguntas = faq?.perguntas || []
const tituloFaq = faq?.titulo || 'Perguntas Frequentes'
---

<Layout titulo="A Nossa Equipa">
  <CapaPagina titulo="A Nossa Equipa" eyebrow="Quem Somos" />

  <section class="secao-conteudo">
    <div class="container">
      {equipa.length > 0 ? (
        <div class="grelha-equipa">
          {equipa.map((membro: any) => (
            <div class="cartao-membro">
              <div class="cartao-membro-foto placeholder-imagem">
                {membro.foto ? (
                  <img
                    src={membro.foto.url}
                    alt={membro.foto.alt || membro.nome}
                    style={`object-position: ${membro.foto.focalX ?? 50}% ${membro.foto.focalY ?? 30}%`}
                  />
                ) : (
                  '[ foto ]'
                )}
              </div>
              <h3 class="cartao-membro-nome">{membro.nome}</h3>
              <p class="cartao-membro-cargo">{membro.cargo}</p>
              {membro.bio && <p class="cartao-membro-bio">{membro.bio}</p>}
            </div>
          ))}
        </div>
      ) : (
        <p class="aviso-vazio">Os membros da equipa vão aparecer aqui assim que forem adicionados no painel de administração.</p>
      )}
    </div>
  </section>

  {perguntas.length > 0 && (
    <section class="secao-faq">
      <div class="container container-estreito">
        <p class="secao-eyebrow secao-eyebrow-centro">
          <span class="traco-assinatura"></span>
          Dúvidas
        </p>
        <h2 class="titulo-faq">{tituloFaq}</h2>

        <div class="lista-faq">
          {perguntas.map((item: any) => (
            <details class="item-faq">
              <summary class="item-faq-pergunta">
                {item.pergunta}
                <span class="item-faq-seta">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
              </summary>
              <p class="item-faq-resposta">{item.resposta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .secao-conteudo {
    padding: 4.5rem 0;
  }

  .grelha-equipa {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2.5rem;
  }

  .cartao-membro-foto {
    aspect-ratio: 1 / 1;
    margin-bottom: 1.25rem;
    font-size: 0.85rem;
    overflow: hidden;
  }

  .cartao-membro-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cartao-membro-nome {
    font-size: 1.15rem;
    margin-bottom: 0.25rem;
    color: var(--cor-texto);
  }

  .cartao-membro-cargo {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--cor-vermelho);
    margin-bottom: 0.75rem;
  }

  .cartao-membro-bio {
    font-size: 0.92rem;
    color: var(--cor-texto-suave);
    line-height: 1.55;
  }

  .aviso-vazio {
    color: var(--cor-texto-suave);
    font-style: italic;
  }

  .secao-faq {
    padding: 5rem 0;
    background: var(--cor-fundo-secao);
  }

  .container-estreito {
    max-width: 780px;
  }

  .secao-eyebrow-centro {
    justify-content: center;
  }

  .titulo-faq {
    font-size: 2rem;
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .lista-faq {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .item-faq {
    background: #FFFFFF;
    border: 1px solid var(--cor-borda);
    padding: 0;
  }

  .item-faq-pergunta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    font-weight: 600;
    font-size: 1rem;
    color: var(--cor-texto);
    cursor: pointer;
    list-style: none;
  }

  .item-faq-pergunta::-webkit-details-marker {
    display: none;
  }

  .item-faq-seta {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--cor-vermelho);
    transition: transform 0.2s ease;
  }

  .item-faq-seta svg {
    width: 100%;
    height: 100%;
  }

  .item-faq[open] .item-faq-seta {
    transform: rotate(180deg);
  }

  .item-faq-resposta {
    padding: 0 1.5rem 1.25rem 1.5rem;
    color: var(--cor-texto-suave);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .titulo-faq {
      font-size: 1.6rem;
    }
  }
</style>