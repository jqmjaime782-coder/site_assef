---
interface Props {
  tipo: string
}

const { tipo } = Astro.props
---

{tipo === 'pessoas' && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="9" cy="7" r="3.2" stroke="currentColor" stroke-width="1.6"></circle>
    <path d="M3.5 20c0-3.3 2.5-5.5 5.5-5.5s5.5 2.2 5.5 5.5" stroke="currentColor" stroke-width="1.6"></path>
    <circle cx="17" cy="8" r="2.4" stroke="currentColor" stroke-width="1.6"></circle>
    <path d="M15.2 14.8c1.9-.4 3.6.4 4.8 2.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
  </svg>
)}

{tipo === 'saude' && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 21s-7-4.35-9.5-8.5C.7 8.8 2.4 5 6 5c2 0 3.2 1 4 2 .8-1 2-2 4-2 3.6 0 5.3 3.8 3.5 7.5C19 16.65 12 21 12 21z" stroke="currentColor" stroke-width="1.6"></path>
    <path d="M9 12h2l1-2 1.5 4 1-2H16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
)}

{tipo === 'agricultura' && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 21V10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    <path d="M12 13c0-3.5-2.5-6-6.5-6C6 10.7 8.3 13 12 13z" stroke="currentColor" stroke-width="1.6"></path>
    <path d="M12 10c0-3.5 2.5-6 6.5-6C18 8.3 15.7 10.5 12 10z" stroke="currentColor" stroke-width="1.6"></path>
  </svg>
)}

{tipo === 'protecao' && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 3l7 3v5.5c0 4.5-3 7.7-7 9.5-4-1.8-7-5-7-9.5V6l7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
    <path d="M9 12l2 2 4-4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
)}

{tipo === 'educacao' && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 4L2 8.5 12 13l10-4.5L12 4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
    <path d="M6 10.5v4.5c0 1.4 2.7 3 6 3s6-1.6 6-3v-4.5" stroke="currentColor" stroke-width="1.6"></path>
    <path d="M21 9v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
  </svg>
)}

{tipo === 'comunidade' && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M12 21s-7-6.5-7-11.5A7 7 0 0 1 19 9.5C19 14.5 12 21 12 21z" stroke="currentColor" stroke-width="1.6"></path>
    <circle cx="12" cy="9.5" r="2.5" stroke="currentColor" stroke-width="1.6"></circle>
  </svg>
)}

{tipo === 'deficiencia' && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="12" cy="4.5" r="1.8" stroke="currentColor" stroke-width="1.6"></circle>
    <path d="M12 8v4l4 2.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M9 12H6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    <circle cx="12" cy="15.5" r="5.5" stroke="currentColor" stroke-width="1.6"></circle>
  </svg>
)}

{tipo === 'genero' && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="8.5" cy="15.5" r="4" stroke="currentColor" stroke-width="1.6"></circle>
    <path d="M11.3 12.7L16 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    <path d="M16 3.5h4.5V8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M20.5 3.5L15.3 8.7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
  </svg>
)}

{tipo === 'formacao' && (
  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M2 8.5L12 4l10 4.5-10 4.5L2 8.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
    <path d="M6 10.5v4c0 1.4 2.7 3 6 3s6-1.6 6-3v-4" stroke="currentColor" stroke-width="1.6"></path>
    <path d="M2 8.5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
  </svg>
)}